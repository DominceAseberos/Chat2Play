{
  "name": "chat2play",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test:smoke": "tsx server/smoke.ts",
    "test:arcade": "tsx server/arcade-smoke.ts",
    "test:arcade:ui": "tsx server/arcade-ui.ts",
    "test:matching": "tsx server/matching-smoke.ts",
    "test:gifs": "tsx server/gif-ui-test.ts",
    "test:reconnect": "tsx server/reconnect-smoke.ts",
    "test:forehead": "tsx server/forehead-smoke.ts",
    "test:forehead:ui": "node server/henyo-voice-ui.mjs",
    "test:game-quit": "tsx server/game-quit-smoke.ts",
    "test:game-quit:ui": "node server/game-quit-ui.mjs",
    "test:saved-profile:ui": "node server/saved-profile-ui.mjs",
    "test:next-profile": "tsx server/matching-profile-next-smoke.ts",
    "test:forehead:turn": "node server/henyo-turn-ui.mjs",
    "test:forehead:results": "node server/henyo-results-render.mjs",
    "test:forehead:hints": "tsx server/forehead-hints-smoke.ts",
    "test:forehead:agreement": "tsx server/forehead-agreement-smoke.ts",
    "test:forehead:agreement-ui": "tsx server/forehead-agreement-ui.mjs",
    "test:forehead:tablet": "node server/henyo-tablet-ui.mjs",
    "test:pong:vertical": "node server/pong-vertical-ui.mjs",
    "start:live": "tsx server/index.ts",
    "test:forehead:voice": "node server/henyo-voice-ui.mjs",
    "test:chat:history": "node server/chat-history-ui.mjs",
    "test:forehead:roles": "node server/henyo-roles-ui.mjs",
    "test:forehead:roles:small": "node server/henyo-roles-ui.mjs --small",
    "test:3d:games": "node server/three-games-ui.mjs",
    "test:pong:physics": "tsx server/pong-physics-smoke.ts",
    "test:pong:serve:ui": "node server/pong-serve-ui.mjs",
    "test:rps:rounds": "node server/rps-rounds-ui.mjs",
    "test:games:swipe": "node server/swipe-games-ui.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@vitejs/plugin-react": "^5.1.0",
    "cors": "^2.8.5",
    "emoji-picker-react": "^5.1.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "concurrently": "^9.2.1",
    "emoji-datasource-twitter": "^16.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
